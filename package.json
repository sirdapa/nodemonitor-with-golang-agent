{
  "name": "node-monitor",
  "version": "1.0.0",
  "description": "Lightweight VPS monitoring dashboard with SQLite persistence",
  "main": "index.js",
  "scripts": {
    "start": "node --experimental-sqlite index.js",
    "dev": "node --experimental-sqlite index.js",
    "agent": "node --experimental-sqlite agent.js",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:${PORT:-3000} --no-autoupdate",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:migrate": "wrangler d1 migrations apply node-monitor --remote",
    "cf:migrate:local": "wrangler d1 migrations apply node-monitor --local"
  },
  "keywords": [
    "monitoring",
    "vps",
    "dashboard",
    "uptime",
    "server"
  ],
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "localtunnel": "^2.0.2",
    "morgan": "^1.10.0",
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
